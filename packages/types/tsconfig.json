{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    // tsup/rollup-plugin-dts still injects baseUrl; silence TS 6 deprecation until tooling drops it.
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src/**/*"
  ]
}
