{
  "name": "@onmyagent/desktop",
  "private": true,
  "version": "0.5.5",
  "description": "OnMyAgent — local control plane for your AI agents",
  "author": {
    "name": "OnMyAgent Contributors"
  },
  "main": "electron/main.mjs",
  "type": "module",
  "scripts": {
    "dev": "node ./scripts/electron-dev.mjs",
    "dev:windows": "node ./scripts/dev-windows.mjs",
    "dev:windows:x64": "node ./scripts/dev-windows.mjs x64",
    "build": "node ./scripts/electron-build.mjs",
    "build:electron": "node ./scripts/electron-build.mjs",
    "package:electron": "pnpm run build:electron && node ./scripts/patch-nsis-install-details.mjs && pnpm exec electron-builder --config electron-builder.yml",
    "package:electron:dir": "pnpm run build:electron && node ./scripts/patch-nsis-install-details.mjs && pnpm exec electron-builder --config electron-builder.yml --dir",
    "package:electron:local": "node ./scripts/package-electron-local.mjs",
    "package:nsis": "node ./scripts/patch-nsis-install-details.mjs && pnpm exec electron-builder --config electron-builder.yml --win --x64 --publish never",
    "electron": "pnpm exec electron ./electron/main.mjs",
    "check:electron": "node ./scripts/check-electron-bridge.mjs",
    "test:runtime": "node --test ../../packages/types/test/task-orchestrator.test.mjs ./scripts/prepare-sidecar-policy.test.mjs ./scripts/prune-bundled-runtime.test.mjs ./scripts/vite-deps-integrity.test.mjs ./scripts/runtime-archive.test.mjs ./electron/task-orchestrator/*.test.mjs ./electron/task-supervisor/*.test.mjs ./electron/task-background-runtime.test.mjs ./electron/task-lifecycle-coordinator.test.mjs ./electron/keep-awake-coordinator.test.mjs ./electron/desktop-handlers/runtime-lifecycle.test.mjs ./electron/channels/test/durable-messaging-task-router.test.mjs ./electron/channels/test/messaging-task-adapter.test.mjs && bun test ./scripts/check-server-runtime-deps.test.mjs ./electron/desktop-paths.test.mjs ./electron/real-home-policy.test.mjs && node --test ./electron/opencode-binary-policy.test.mjs ./electron/windows-jump-list.test.mjs ./electron/windows-titlebar.test.mjs ./electron/desktop-cold-start.test.mjs ./electron/desktop-command-contract.test.mjs ./electron/desktop-handlers/domain-smoke.test.mjs ./electron/desktop-handlers/expert-package-delete.test.mjs ./electron/expert-marketplace.test.mjs ./electron/expert-package-skills.test.mjs ./electron/managed-tools/recommended-managed-cli.boundary.test.mjs ./electron/personal-agent-runtime/run-persistence.test.mjs ./electron/personal-agent-runtime/runtime.test.mjs ./electron/personal-agent-runtime/windows-spawn.test.mjs ./electron/tencent-docs-connector/*.test.mjs ./electron/baidu-drive-connector/*.test.mjs ./electron/kdocs-connector/*.test.mjs ./electron/dingtalk-connector/*.test.mjs ./electron/wecom-connector/*.test.mjs ./electron/tencent-meeting-connector/*.test.mjs ./electron/browser-runtime/*.test.mjs",
    "test:vite-deps-integrity": "node --test ./scripts/vite-deps-integrity.test.mjs",
    "test:windows-runtime": "node ../../scripts/dev/windows-runtime-test.mjs",
    "test:browser-smoke": "electron ./scripts/browser-runtime-smoke.mjs",
    "test:release-smoke": "pnpm build && node ./scripts/check-electron-bridge.mjs && pnpm exec electron-builder --config electron-builder.yml --dir --publish never",
    "typecheck": "pnpm typecheck:electron",
    "typecheck:electron": "pnpm --dir ../server exec tsc -p ../desktop/tsconfig.electron.json --noEmit",
    "prepare:sidecar": "node ./scripts/prepare-sidecar.mjs"
  },
  "dependencies": {
    "@onmyagent/types": "workspace:*",
    "@opencode-ai/sdk": "1.18.18",
    "discord.js": "^14.27.0",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0",
    "undici": "^6.24.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3"
  },
  "packageManager": "pnpm@10.27.0",
  "license": "Apache-2.0"
}
